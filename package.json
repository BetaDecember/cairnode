{
  "name": "cairnode",
  "productName": "Cairnode",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agentic coding desktop app for macOS",
  "license": "MIT",
  "author": "Cairnode contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetaDecember/cairnode.git"
  },
  "homepage": "https://github.com/BetaDecember/cairnode#readme",
  "bugs": "https://github.com/BetaDecember/cairnode/issues",
  "engines": {
    "node": ">=24"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/core/**/*.test.ts\"",
    "test:ui": "playwright test",
    "agent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/try-agent.ts"
  },
  "dependencies": {
    "diff2html": "^3.4.52",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.23",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
